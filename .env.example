# Neon Postgres (pooled connection string from the Neon console / MCP)
DATABASE_URL=
# MailerSend API token (the value formerly stored as MM_MLSN_API_TOKEN)
MAILERSEND_API_TOKEN=
# Sender identity (domain must be verified in MailerSend)
MAIL_FROM_EMAIL=info@marlybaskha.ca
MAIL_FROM_NAME=Marly & Michael
# Admin dashboard login + cookie signing secret (openssl rand -hex 32)
ADMIN_PASSWORD=
SESSION_SECRET=
# Public site URL (used for absolute links in emails / metadata)
NEXT_PUBLIC_SITE_URL=https://marlybaskha.ca
# Decorator portal (/decor) password
DECOR_PASSWORD=
# Public Pinterest board mirrored into the decor portal's Inspiration tab
PINTEREST_BOARD_URL=https://ca.pinterest.com/mbaskhairoun/our-wedding/
# Vercel Blob read/write token (auto-created when the mm-wedding-media store is connected; `vercel env pull`)
BLOB_READ_WRITE_TOKEN=
# Vercel cron auth for /api/decor/sync (openssl rand -hex 24)
CRON_SECRET=
